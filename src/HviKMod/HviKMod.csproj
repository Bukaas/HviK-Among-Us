<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>

        <Version>0.3.0</Version>
        <Description>HviK Community Mod fuer Among Us</Description>
        <Authors>HviK Community</Authors>
        <RootNamespace>HviKMod</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Reactor 2.5.1 ist fuer Among Us v18 noetig (2.5.0 crasht beim Laden) -->
        <PackageReference Include="AllOfUs.MiraAPI" Version="0.5.0" />
        <PackageReference Include="Reactor" Version="2.5.1-ci.384" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.8.18" PrivateAssets="all" />

        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.png" />
    </ItemGroup>

    <!-- Nach jedem Build die DLL direkt in die Test-Installation kopieren -->
    <Target Name="CopyToDevGame" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\.game\BepInEx\plugins')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\.game\BepInEx\plugins\" />
    </Target>
</Project>
